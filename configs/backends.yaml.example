# Example Backends Configuration
# Sensitive keys are injected via environment variables (e.g. ${OPENAI_API_KEY})
backends:
  - id: openai-gpt-4o-mini
    provider: openai
    model: gpt-4o-mini
    endpoint: "https://api.openai.com/v1"
    cost_per_1k_prompt: 0.00015
    cost_per_1k_completion: 0.00060
    capabilities:
      - json_mode
    context_length: 128000

  - id: anthropic-claude-3-5-sonnet
    provider: anthropic
    model: claude-3-5-sonnet-20241022
    endpoint: "https://api.anthropic.com/v1"
    cost_per_1k_prompt: 0.003
    cost_per_1k_completion: 0.015
    capabilities:
      - json_mode
    context_length: 200000

  - id: local-ollama-qwen2.5-0.5b
    provider: local_vllm
    model: qwen2.5:0.5b
    endpoint: "http://localhost:11434/v1"
    cost_per_1k_prompt: 0.0020
    cost_per_1k_completion: 0.00015
    capabilities:
      - json_mode
    context_length: 8192
