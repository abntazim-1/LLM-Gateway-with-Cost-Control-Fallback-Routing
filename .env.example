# ─────────────────────────────────────────────────────────────
# LLM Gateway — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control (it is in .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Admin ──────────────────────────────────────────────────────
# Secret used to authenticate /admin/* endpoints.
# Generate a strong value: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=change-me-before-running

# ── LLM Backend API Keys ───────────────────────────────────────
# Only needed for backends you actually enable. The default config runs
# entirely on local Ollama models and needs none of these.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Groq speaks the OpenAI protocol and has a free tier, which makes it a
# practical backend for a public demo — visitors need no key of their own.
GROQ_API_KEY=gsk_...

# ── Backend selection ──────────────────────────────────────────
# Unset (default) uses configs/backends.yaml — the local Ollama models.
# Point at the cloud config for a deployed instance:
# BACKENDS_CONFIG_PATH=configs/backends.cloud.yaml

# ── Client API Keys (referenced in configs/budgets.yaml) ───────
CLIENT_API_KEY_TIER1=sk-test-tier-1
CLIENT_API_KEY_DEMO=sk-demo-live
